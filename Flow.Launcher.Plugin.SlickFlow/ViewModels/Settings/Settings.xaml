<UserControl x:Class="Flow.Launcher.Plugin.SlickFlow.ViewModels.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Flow.Launcher.Plugin.SlickFlow.ViewModels.Item"
             xmlns:global="clr-namespace:"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="600">
    <UserControl.Resources>
        <global:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" /> <!-- filler -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- DB File Label -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="DB File Path:" VerticalAlignment="Center" />

        <!-- DB File Path + Browse -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding DbFilePath}" />

            <Button Grid.Column="1"
                    Content="Browse"
                    Margin="6,0,0,0"
                    Command="{Binding BrowseDbFolderCommand}" />
        </Grid>

        <!-- Icon Folder Label -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Icon Folder Path:" VerticalAlignment="Center" />

        <!-- Icon Folder Path + Browse -->
        <Grid Grid.Row="3" Grid.Column="0" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="{Binding IconDirPath}" />

            <Button Grid.Column="1"
                    Content="Browse"
                    Margin="6,0,0,0"
                    Command="{Binding BrowseIconFolderCommand}" />
        </Grid>

        <!-- Python Interpreter Label -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Python Interpreter (python.exe or install folder; empty = auto-detect):"
                   Margin="0,6,0,0" VerticalAlignment="Center" />

        <!-- Python Interpreter Path + Browse -->
        <Grid Grid.Row="5" Grid.Column="0" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="{Binding PythonPath}" />

            <Button Grid.Column="1"
                    Content="Browse"
                    Margin="6,0,0,0"
                    Command="{Binding BrowsePythonCommand}" />
        </Grid>

        <!-- PowerShell Version -->
        <CheckBox Grid.Row="6" Grid.Column="0"
                  Margin="0,6,0,0"
                  Content="Run .ps1 scripts with PowerShell 7 (pwsh)"
                  ToolTip="Falls back to Windows PowerShell when pwsh isn't installed."
                  IsChecked="{Binding UsePwsh}" />

        <!-- Action Buttons -->
        <StackPanel Grid.Row="7" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Save" Width="80" Command="{Binding SaveCommand}" />
            <Button Content="Add Item" Width="90" Margin="6,0,0,0" Command="{Binding AddItemCommand}" />
            <Button Content="Refresh" Width="80" Margin="6,0,0,0" Command="{Binding ReloadItemsCommand}" />
        </StackPanel>

        <!-- Items Label -->
          <TextBlock Grid.Row="0" Grid.Column="1"
            Text="Items"
            FontWeight="Bold"
            Margin="4,4,0,4" />

        <!-- Search Bar + Sort -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="4,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     VerticalAlignment="Center" />

            <!-- Hit testing is disabled while the popup is open so the click that
                 dismisses it doesn't immediately toggle it open again. -->
            <ToggleButton x:Name="SortButton"
                          Grid.Column="1"
                          Margin="6,0,0,0"
                          Padding="6,2"
                          ToolTip="Sort items"
                          IsChecked="{Binding IsOpen, ElementName=SortPopup, Mode=TwoWay}"
                          IsHitTestVisible="{Binding IsOpen, ElementName=SortPopup, Converter={StaticResource InverseBool}}">
                <TextBlock Text="&#xE8CB;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14"
                           VerticalAlignment="Center" />
            </ToggleButton>

            <Popup x:Name="SortPopup"
                   PlacementTarget="{Binding ElementName=SortButton}"
                   Placement="Bottom"
                   HorizontalOffset="-110"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="4"
                        MinWidth="140">
                    <ListBox ItemsSource="{Binding SortOptions}"
                             SelectedValue="{Binding SortMode}"
                             SelectedValuePath="Key"
                             DisplayMemberPath="Value"
                             BorderThickness="0"
                             SelectionChanged="SortOption_SelectionChanged" />
                </Border>
            </Popup>
        </Grid>

        <!-- Items List -->
        <ListBox Grid.Row="2" Grid.Column="1" Grid.RowSpan="7"
            ItemsSource="{Binding Items}"
            MaxHeight="500"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel"
            ScrollViewer.CanContentScroll="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:ItemView />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
